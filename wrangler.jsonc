{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagra",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "PIAZZA", "class_name": "Piazza" },
      { "name": "CLASSIFICA", "class_name": "Classifica" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Piazza"] },
    { "tag": "v3", "new_sqlite_classes": ["Classifica"] }
  ],
  "observability": { "enabled": true }
}
